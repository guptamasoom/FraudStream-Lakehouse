ENVIRONMENT=local
PROJECT_NAME=fraudstream-lakehouse

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Local object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=fraudstream
